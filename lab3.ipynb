    "# ================== Задание №4 - Сравнение для конкретного случая ==================\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"Задание №4. Сравнение с аналитическими соотношениями ТМО\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Параметры для тестирования\n",
    "lam = 0.5    # интенсивность входного потока (1/сек)\n",
    "mu = 0.6     # интенсивность обработки (1/сек)\n",
    "T_model = 1700  # увеличим время для лучшей статистики (было 17.15)\n",
    "rho = lam / mu\n",
    "\n",
    "print(f\"\\nПараметры эксперимента:\")\n",
    "print(f\"  λ = {lam} заявок/сек\")\n",
    "print(f\"  μ = {mu} заявок/сек\")\n",
    "print(f\"  T = {T_model} сек\")\n",
    "print(f\"  Коэффициент загрузки ρ = λ/μ = {lam}/{mu} = {rho:.3f}\")\n",
    "\n",
    "# Теоретические значения\n",
    "theor_pobr = 1 / (1 + rho)\n",
    "theor_load = rho / (1 + rho)\n",
    "\n",
    "print(f\"\\nТеоретические значения (по формулам ТМО):\")\n",
    "print(f\"  P_обр = 1/(1+ρ) = 1/(1+{rho:.3f}) = {theor_pobr:.4f}\")\n",
    "print(f\"  Загрузка = ρ/(1+ρ) = {rho:.3f}/(1+{rho:.3f}) = {theor_load:.4f}\")\n",
    "\n",
    "# Запускаем симуляцию (можно несколько раз для усреднения)\n",
    "print(f\"\\nЗапуск имитационной модели...\")\n",
    "\n",
    "# Для воспроизводимости\n",
    "np.random.seed(42)\n",
    "\n",
    "# Запускаем один эксперимент с подробным выводом\n",
    "results = simulate_system(lam, mu, T_model)\n",
    "\n",
